// A tour of every feature the parser accepts, for exercising the printer.

// --- Imports ---

import std
import std::io
import std::io as console
import std::*
import std::{result, vec as v, collections::*,}

// --- Types ---

/// Aliases of every primitive and composite type.
type Count = int
type Ratio = float
type Flag = bool
type Name = string
type Nothing = ()
type Pair = (int, string)
type Matrix = [[float]]
type Point = { x: int, y: int }
type Nested = [(Count, { origin: Point, tags: [Name], })]

/// Sum types: one line, many lines, and payloads of each shape.
type Shape = Circle(float) | Rectangle(float, float) | Dot
type Tree =
	| Leaf
	| Node(Tree, int, Tree)
	| Labelled({ label: string }, [Tree])
type Unit = Only

// --- Literals ---

let decimal = 1_000_000
let hex = 0xff
let binary = 0b1010
let octal = 0o17
let explicit = 0d42
let negative = -5
let half = 10.5
let tiny = 2.5e-3
let huge = 1e10
let yes = true
let no = false
let greeting = "Hello, world!"
let unicode = "こんにちは世界 😊"
let unit = ()

// --- Tuples, lists and destructuring ---

let pair = (1, "one")
let nested = ((1, 2), [3, 4], ())
let trailing = (1, 2,)
let numbers = [1, 2, 3,]
let empty = []
let (first, second) = pair
let ((a, b), rest, _unit) = nested
let { x, y: why } = origin
let { x: (p, q), y: ignored } = weird

// --- Operators, tightest to loosest ---

let power = a ** b ** c
let arithmetic = a * b / c % d + e - f
let grouped = (a + b) * (c - d) / (e ** (f ** g))
let consed = a + b :: c :: []
let compared = a < b == c >= d != e
let logic = !a && b || c && !(d || e)
let signs = -a + +b - ~c
let negate_call = -f x + -(f y)
let unary_call = !is_empty list

// --- Application ---

let three = add 1 2
let curried = (add 1) 2
let parenthesised = f (n - 1) (g x)
let uncurried = f x, y
let unit_call = f ()
let lambda_call = (a -> a + 1) 41
let in_operator = f a + g b * h c

// --- Functions ---

let identity = x -> x
let add = a b -> a + b
let scale = (factor: int) value -> factor * value
let typed = (p: (int, int)) (xs: [int]) (r: { x: int }) -> p
let destructuring = (a, b) { x, y: z } -> a + b + x + z
let nested_lambda = a -> b -> c -> a + b + c
let compose = f g -> x -> f (g x)

// --- Control flow ---

let max = a b -> if a > b { a } else { b }
let sign = x -> if x > 0 {
	1
} else if x < 0 {
	-1
} else {
	0
}
let no_else = if ready { go }
let nested_if = if a {
	if b {
		c
	} else {
		d
	}
} else {
	e
}

let fib = n -> match n {
	| 0 -> 0
	| 1 -> 1
	| n -> fib (n - 1) + fib (n - 2)
}

/// Every pattern kind.
let describe = value -> match value {
	| 0 | 1 | 2 -> "small"
	| -1 -> "minus one"
	| 3.5 -> "three and a half"
	| true -> "yes"
	| "text" -> "a string"
	| () -> "unit"
	| _ -> "anything"
}

let shape_area = shape -> match shape {
	| Circle(r) -> 3 * r * r
	| Rectangle(w, h) -> w * h
	| Dot -> 0
}

let sum = list -> match list {
	| [] -> 0
	| x :: rest -> x + sum rest
}

let walk = tree -> match tree {
	| Leaf -> 0
	| Node(Leaf, v, Leaf) -> v
	| Node(l, v, r) -> walk l + v + walk r
	| Labelled({ label: l }, children) -> len children
}

let classify = point -> match point {
	| (0, 0) -> "origin"
	| (x, 0) | (0, x) -> "axis"
	| { x: 0, y: y } -> "on y"
	| (a, (b, _)) :: tail -> "nested"
	| (a | b) :: c -> "or then cons"
	| a :: (b | c) -> "cons then or"
	| (x, y,) -> "trailing comma"
	| (single) -> "parenthesised"
}

let match_operand = (match a {
	| 0 -> 1
	| _ -> 2
}) + 1

// --- Line ends ---

let continued = fib (n - 1) +
	fib (n - 2)
let continued_list = [1,
	2,
	3]
let continued_call = f (
	a)
let continued_logic = a &&
	b ||
	c
let one = 1; let two = 2;


let after_blank_lines = 3 // end of line comment
// A trailing comment at the end of the file.
